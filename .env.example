# --- Local laptop (Docker Postgres) ---
# Matches infra/docker/docker-compose.yml db credentials.
# Host port defaults to 5433 (container still listens on 5432).
DATABASE_URL=postgresql://currents:currents@127.0.0.1:5433/currents

# Host port published for Postgres.
POSTGRES_PORT=5433

# Host port published for the optional compose `backend` profile (`full`).
BACKEND_PORT=3000

# --- AWS Develop (ECS → future RDS) ---
# See infra/aws/dev/README.md. Stack: currents-develop-foundation.
# Endpoint: https://develop.currentscommunity.com
# Until Dev RDS exists, omit DATABASE_URL on the ECS task (use /api/live for health).
# DATABASE_URL=postgresql://currents_dev:...@currents-dev.XXXX.rds.amazonaws.com:5432/currents

# --- Luma calendar integration (server-side only) ---
# Create a calendar-scoped key under Luma → Settings → Developer.
LUMA_API_KEY=
LUMA_CALENDAR_ID=cal-97DAgWBFfaaIiye
# Generated when a Luma webhook is created for /api/luma/webhooks.
LUMA_WEBHOOK_SECRET=

# --- Better Auth (Google OAuth + Email OTP) ---
# Random 32+ byte secret used to sign sessions/tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL Better Auth uses for callbacks; must match the deployed origin.
BETTER_AUTH_URL=http://localhost:3000
# Same value, exposed to the browser bundle (Next.js only inlines
# NEXT_PUBLIC_-prefixed vars client-side) — keep in sync with BETTER_AUTH_URL.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
# From Google Cloud Console -> APIs & Services -> Credentials (OAuth client ID).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs member-application claim tokens. Falls back to BETTER_AUTH_SECRET if unset.
MEMBER_APPLICATION_CLAIM_SECRET=

# --- AWS SES (Email OTP delivery, server-side only) ---
# Verified sender identity in SES (domain or single email must be verified first).
SES_FROM_EMAIL=
# Region SES is configured in.
AWS_REGION=ap-southeast-2

# --- GeoNames (State/City lookups for the join form, server-side only) ---
# Free account username: http://www.geonames.org/login
GEONAMES_USERNAME=
