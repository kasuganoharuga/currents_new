# --- Local laptop (Docker Postgres) ---
# Matches infra/docker/docker-compose.yml db credentials.
# Host port defaults to 5433 (container still listens on 5432).
DATABASE_URL=postgresql://currents:currents@127.0.0.1:5433/currents

# Host port published for Postgres.
POSTGRES_PORT=5433

# Host port published for the optional compose `backend` profile (`full`).
BACKEND_PORT=3000

# --- AWS Develop (ECS → future RDS) ---
# See infra/aws/dev/README.md. Stack: currents-develop-foundation.
# Endpoint: https://develop.currentscommunity.com
# Until Dev RDS exists, omit DATABASE_URL on the ECS task (use /api/live for health).
# DATABASE_URL=postgresql://currents_dev:...@currents-dev.XXXX.rds.amazonaws.com:5432/currents

# --- Luma calendar integration (server-side only) ---
# Create a calendar-scoped key under Luma → Settings → Developer.
LUMA_API_KEY=
LUMA_CALENDAR_ID=cal-97DAgWBFfaaIiye
# Generated when a Luma webhook is created for /api/luma/webhooks.
LUMA_WEBHOOK_SECRET=
