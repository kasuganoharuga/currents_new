# Currents — AWS Production (ECS task env reference)
# Do not commit secrets.

APP_ENV=production
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Injected from Secrets Manager `currents-production/database-url`.
# DATABASE_URL=postgresql://currents_app:...@currents-production-postgres.XXXX.ap-southeast-2.rds.amazonaws.com:5432/currents?sslmode=require&uselibpqcompat=true

BETTER_AUTH_URL=https://currentscommunity.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://currentscommunity.com
# Auth/Geo/Luma secrets are injected via the GitHub `production` environment.
# See .github/workflows/deploy-production.yml.

SES_FROM_EMAIL=noreply@currentscommunity.com
AWS_REGION=ap-southeast-2
