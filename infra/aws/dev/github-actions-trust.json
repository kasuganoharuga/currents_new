        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:Torus-Group/currents_new:ref:refs/heads/develop",
            "repo:Torus-Group/currents_new:environment:develop",
            "repo:Torus-Group@296493582/currents_new@1332590298:ref:refs/heads/develop",
            "repo:Torus-Group@296493582/currents_new@1332590298:environment:develop"
          ]
