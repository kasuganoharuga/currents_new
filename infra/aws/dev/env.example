# Currents — AWS Develop (ECS task env reference)
# Environment: develop only. Do not commit secrets.

APP_ENV=development
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Injected from Secrets Manager `currents-develop/database-url` — do not put
# the password in this file or in the task definition environment.
# DATABASE_URL=postgresql://currents_dev:...@currents-develop-postgres.XXXX.ap-southeast-2.rds.amazonaws.com:5432/currents?sslmode=require

# --- Better Auth (Google OAuth + Email OTP) ---
BETTER_AUTH_URL=https://develop.currentscommunity.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://develop.currentscommunity.com
# BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# MEMBER_APPLICATION_CLAIM_SECRET, GEONAMES_USERNAME, and LUMA_WEBHOOK_SECRET
# are injected via GitHub Actions secrets — see .github/workflows/deploy-develop.yml.

# --- AWS SES (Email OTP delivery) ---
SES_FROM_EMAIL=noreply@currentscommunity.com
AWS_REGION=ap-southeast-2
