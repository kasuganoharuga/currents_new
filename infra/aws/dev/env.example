# Currents — AWS Develop (ECS task env reference)
# Environment: develop only. Do not commit secrets.
#
# Until Dev RDS exists, omit DATABASE_URL.
# ALB health check uses /api/live (no DB).

APP_ENV=development
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# After RDS exists (same VPC as ECS tasks):
# DATABASE_URL=postgresql://currents_dev:CHANGE_ME@currents-dev.XXXXXX.ap-southeast-2.rds.amazonaws.com:5432/currents

# --- Better Auth (Google OAuth + Email OTP) ---
BETTER_AUTH_URL=https://develop.currentscommunity.com
NEXT_PUBLIC_BETTER_AUTH_URL=https://develop.currentscommunity.com
# BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and
# MEMBER_APPLICATION_CLAIM_SECRET are injected via GitHub Actions secrets when set —
# see .github/workflows/deploy-develop.yml.

# --- AWS SES (Email OTP delivery) ---
SES_FROM_EMAIL=noreply@currentscommunity.com
AWS_REGION=ap-southeast-2
