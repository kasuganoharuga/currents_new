{
  "family": "currents-develop-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::765332581489:role/currents-develop-ecs-execution",
  "taskRoleArn": "arn:aws:iam::765332581489:role/currents-develop-app-task",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "765332581489.dkr.ecr.ap-southeast-2.amazonaws.com/currents-develop/app:REPLACE_TAG",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "APP_ENV", "value": "development" },
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "HOSTNAME", "value": "0.0.0.0" },
        {
          "name": "BETTER_AUTH_URL",
          "value": "https://develop.currentscommunity.com"
        },
        {
          "name": "NEXT_PUBLIC_BETTER_AUTH_URL",
          "value": "https://develop.currentscommunity.com"
        },
        { "name": "AWS_REGION", "value": "ap-southeast-2" },
        { "name": "SES_FROM_EMAIL", "value": "noreply@currentscommunity.com" },
        { "name": "AIRTABLE_BASE_ID", "value": "appzuTJ0yeC0GRtTK" },
        {
          "name": "AIRTABLE_MEMBER_APPLICATIONS_TABLE_ID",
          "value": "tblCwf56EE6xT94C0"
        },
        { "name": "GOOGLE_CLIENT_ID", "value": "" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:765332581489:secret:currents-develop/database-url-eir0B9"
        },
        {
          "name": "AIRTABLE_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:765332581489:secret:currents-develop/airtable-token-97Dh1K"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/currents-develop-app",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "app"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:3000/api/live').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 10,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 45
      }
    }
  ]
}
