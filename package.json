{
  "name": "currents",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d --wait db && pnpm db:migrate",
    "docker:up:full": "docker compose --env-file .env -f infra/docker/docker-compose.yml --profile full up -d --build --wait && pnpm db:migrate",
    "docker:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml --profile full down --remove-orphans",
    "db:migrate": "tsx db/migrate.ts",
    "db:psql": "docker compose --env-file .env -f infra/docker/docker-compose.yml exec db psql -U currents -d currents",
    "db:reset": "docker compose --env-file .env -f infra/docker/docker-compose.yml --profile full down -v --remove-orphans && pnpm docker:up"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.18.0"
}
